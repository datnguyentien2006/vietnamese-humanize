FRONTEND_ORIGIN=http://localhost:3000
CONTRIBUTIONS_ENABLED=false
ADMIN_API_ENABLED=false
GROQ_API_KEY=
GROQ_REWRITE_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# --- v1.3 Humanize: dedicated model (vLLM) + Groq fallback ---
# OpenAI-compatible base URL of the fine-tuned humanizer endpoint
# (see training/serve/runpod_vllm.md). Empty = use the Groq fallback.
HUMANIZER_API_BASE=
HUMANIZER_API_KEY=
HUMANIZER_MODEL=humanizer-vi
HUMANIZER_TIMEOUT_SECONDS=45.0
HUMANIZER_FALLBACK_GROQ=true
DEBUG_ERRORS=false
ADMIN_API_KEY=
DATABASE_URL=sqlite:///./dev.db
TRUSTED_PROXY_HOSTS=127.0.0.1,localhost,::1
TRUST_PRIVATE_PROXIES=false
